# Copy to backend/.env and adjust as needed.

# Frontend dev server origin, allowed for CORS.
FRONTEND_ORIGIN=http://localhost:5173


DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=synapse
DATABASE_PASSWORD=synapse
DATABASE_NAME=synapse

# Parent folder for every domain's Obsidian vault (absolute path, must exist
# and be writable). Saving a domain creates $VAULTS_ROOT/<slug>/. Keep it
# outside this repo; vault contents are never committed.
VAULTS_ROOT=/absolute/path/to/synapse-vaults

# Temporal server (docker compose) and per-process agent concurrency.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
MAX_CLAUDE_PROCESSES=4

# Host/port the backend binds to. Leave unset unless you want it somewhere
# else — the backend only binds to 127.0.0.1 by design (see NFR1).
APP_HOST=127.0.0.1
APP_PORT=8000
