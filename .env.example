# Copy to backend/.env and adjust as needed.

# Frontend dev server origin, allowed for CORS.
FRONTEND_ORIGIN=http://localhost:5173


DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=synapse
DATABASE_PASSWORD=synapse
DATABASE_NAME=synapse

# Directory for the embedded Kùzu graph database.
KUZU_DB_PATH=.synapse-graph

# Host/port the backend binds to. Leave unset unless you want it somewhere
# else — the backend only binds to 127.0.0.1 by design (see NFR1).
APP_HOST=127.0.0.1
APP_PORT=8000
