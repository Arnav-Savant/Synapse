# Copy to backend/.env and adjust as needed.

# Absolute path to the knowledge content directory (see docs/ARCHITECTURE.md
# §1). Defaults to synapse-knowledge/ inside this repo — leave unset unless
# you want it somewhere else.
# KNOWLEDGE_REPO_PATH=/absolute/path/to/synapse-knowledge

# Frontend dev server origin, allowed for CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Postgres connection settings (see docker-compose.yml for the containerized
# default; these values are for running the backend directly against a
# local Postgres instance). They compose into the async Postgres URL via
# ServerConfig.database_url.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=synapse
DATABASE_PASSWORD=synapse
DATABASE_NAME=synapse

# Directory for the embedded Kùzu graph database.
KUZU_DB_PATH=.synapse-graph

# Host/port the backend binds to. Leave unset unless you want it somewhere
# else — the backend only binds to 127.0.0.1 by design (see NFR1).
# APP_HOST=127.0.0.1
# APP_PORT=8000
